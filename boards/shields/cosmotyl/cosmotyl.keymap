// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        // letter layer
        default_layer {
            //                                                                              | | 
            bindings = <
                                &kp NUMBER_2   &kp NUMBER_3   &kp NUMBER_4     &kp NUMBER_5     &kp NUMBER_6 &kp NUMBER_7      &kp NUMBER_8    &kp NUMBER_9
                &kp NUMBER_1    &kp W          &kp E          &kp R            &kp T            &kp Y        &kp U             &kp I           &kp O           &kp NUMBER_10
                &kp Q           &mt LEFT_GUI S &mt LEFT_ALT D &mt LEFT_SHIFT F &kp G            &kp H        &mt RIGHT_SHIFT J &mt RIGHT_ALT K &mt RIGHT_GUI L &kp p
                &mt LEFT_CTRL A &kp X          &kp C          &kp V            &kp B            &kp N        &kp N             &kp COMMA       &kp PERIOD      &mt RIGHT_CTRL SEMICOLON
                &kp Z           &mkp MB4       &mkp MB1                                                                        &bt BT_PRV      &bt BT_NXT      &kp /
                &kp BACKSPACE   &mo 2          &kp HOME       &kp DELETE       &mo 1            &lt SPACE 1  &kp ENTER         &kp END         &mo 2           &kp DELETE
            >;
        };

        // symbol layer
        layer1 {
            //                                                                                       | | 
            bindings = <
                                   &kp F2            &kp F3            &kp F4              &kp F5           &kp F8       &kp F9             &kp F10          &kp F11
                &kp F1             &kp AT            &kp PIPE          &kp LBRC            &kp RBRC         &kp DQT      &kp N7             &kp N8           &kp N9           &kp F12
                &kp EXCL           &mt LEFT_GUI DLLR &mt LEFT_ALT BSLH &mt LEFT_SHIFT LPAR &kp RPAR         &kp EQUAL    &mt RIGHT_SHIFT N4 &mt RIGHT_ALT N5 &mt RIGHT_GUI N6 &kp STAR
                &mt LEFT_CTRL HASH &kp CARET         &kp FSLH          &kp LBKT            &kp RBKT         &kp AMPS     &kp N1             &kp N2           &kp N3           &mt RIGHT_CTRL PLUS
                &kp PRCNT          &trans            &trans                                                                                  &trans          &trans           &kp BSLH
                &trans             &trans            &trans            &trans              &trans           &trans       &trans              &trans          &trans           &trans
            >;
        };

        // movement and symbol layer
        layer2 {
            //                                     | | 
            bindings = <
                       &trans &trans &trans &trans     &trans    &trans         &trans         &trans
                &trans &trans &trans &trans &trans     &kp STAR  &kp ESC        &kp UP_ARROW   &trans          &trans
                &trans &trans &trans &trans &trans     &kp MINUS &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &trans
                &trans &trans &trans &trans &trans     &kp AMPS  &kp TAB        &kp DQT        &trans          &trans
                &trans &trans &trans                                            &trans         &studio_unlock  &trans
                &trans &trans &trans &trans &trans     &trans    &trans         &trans         &trans          &trans
            >;
        };

        // Gaming layer
        layer3 {
            //                                    | | 
            bindings = <
                       &trans &trans &trans &trans     &trans &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans
                &trans &kp S  &kp D  &kp F  &trans     &trans &trans &trans &trans &trans
                &kp A  &trans &trans &trans &trans     &trans &trans &tarns &trans &trans
                &trans &trans &trans                                 &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans
            >;
        };
    };
};
