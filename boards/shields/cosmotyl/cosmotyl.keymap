// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>

/ {
    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        // letter layer
        default_layer {
            //                                                            | |
            bindings = <
                              &kp N2     &kp N3     &kp N4       &kp N5        &kp N6 &kp N7       &kp N8     &kp N9
                &kp N1        &kp W      &kp E      &kp R        &kp T         &kp Y  &kp U        &kp I      &kp O      &kp NUMBER_0
                &kp Q         &mt LGUI S &mt LALT D &mt LSHIFT F &kp G         &kp H  &mt RSHIFT J &mt RALT K &mt RGUI L &kp P
                &mt LCTRL A   &kp X      &kp C      &kp V        &kp B         &kp N  &kp M        &kp COMMA  &kp PERIOD &mt RCTRL SEMICOLON
                &kp Z         &mkp MB4   &mkp MB1                                                  &bt BT_PRV &bt BT_NXT &kp FSLH
                &kp BACKSPACE &mo 2      &kp HOME   &kp DELETE   &mo 1         &kp DELETE &mo 2  &kp END &kp ENTER &lt 1 SPACE 
            >;
        };

        // symbol layer
        layer1 {
            //                                                                       | |
            bindings = <
                               &kp F2        &kp F3        &kp F4          &kp F5         &kp F8    &kp F9        &kp F10     &kp F11
                &kp F1         &kp AT        &kp PIPE      &kp LBRC        &kp RBRC       &kp DQT   &kp N7        &kp N8      &kp N9      &kp F12
                &kp EXCL       &mt LGUI DLLR &mt LALT BSLH &mt LSHIFT LPAR &kp RPAR       &kp EQUAL &mt RSHIFT N4 &mt RALT N5 &mt RGUI N6 &kp STAR
                &mt LCTRL HASH &kp CARET     &kp FSLH      &kp LBKT        &kp RBKT       &kp AMPS  &kp N1        &kp N2      &kp N3      &mt RCTRL PLUS
                &kp PRCNT      &trans        &trans                                                               &trans      &trans      &kp BSLH
                &trans         &trans        &trans        &trans          &trans         &trans    &trans        &trans      &trans      &trans
            >;
        };

        // movement and symbol layer
        layer2 {
            //                                     | | 
            bindings = <
                       &trans &trans &trans &trans     &trans    &trans   &trans   &trans
                &trans &trans &trans &trans &trans     &kp STAR  &kp ESC  &kp UP   &trans          &trans
                &trans &trans &trans &trans &trans     &kp MINUS &kp LEFT &kp DOWN &kp RIGHT       &trans
                &trans &trans &trans &trans &trans     &kp AMPS  &kp TAB  &kp DQT  &trans          &trans
                &trans &trans &trans                                      &trans   &studio_unlock  &trans
                &trans &trans &trans &trans &trans     &trans    &trans   &trans   &trans          &trans
            >;
        };

        // Gaming layer
        layer3 {
            //                                    | | 
            bindings = <
                       &trans &trans &trans &trans     &trans &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans
                &trans &kp S  &kp D  &kp F  &trans     &trans &trans &trans &trans &trans
                &kp A  &trans &trans &trans &trans     &trans &trans &trans &trans &trans
                &trans &trans &trans                                 &trans &trans &trans
                &trans &trans &trans &trans &trans     &trans &trans &trans &trans &trans
            >;
        };
    };
};
