// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    // --- TIMELESS HOMEROW MODS ---
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            // Auslöser: Alle Tasten auf der RECHTEN Seite
            hold-trigger-key-positions = <4 5 6 7 13 14 15 16 17 23 24 25 26 27 33 34 35 36 37 41 42 43 49 50 51 52 53>;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            // Auslöser: Alle Tasten auf der LINKEN Seite
            hold-trigger-key-positions = <0 1 2 3 8 9 10 11 12 18 19 20 21 22 28 29 30 31 32 38 39 40 44 45 46 47 48>;
            bindings = <&kp>, <&kp>;
        };

        hms_l: homerow_shift_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT_LEFT";
            #binding-cells = <2>;
            tapping-term-ms = <200>; // Faster resolve time than your normal 280ms
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <4 5 6 7 13 14 15 16 17 23 24 25 26 27 33 34 35 36 37 41 42 43 49 50 51 52 53>;
            bindings = <&kp>, <&kp>;
        };

        hms_r: homerow_shift_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_SHIFT_RIGHT";
            #binding-cells = <2>;
            tapping-term-ms = <200>; 
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 8 9 10 11 12 18 19 20 21 22 28 29 30 31 32 38 39 40 44 45 46 47 48>;
            bindings = <&kp>, <&kp>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        // letter layer
        default_layer {
            //                                                              | |
            bindings = <
                              &kp N2      &kp N3      &kp N4          &kp N5        &kp N6 &kp N7          &kp N8      &kp N9
                &kp N1        &kp W       &kp E       &kp R           &kp T         &kp Y  &kp U           &kp I       &kp O       &kp NUMBER_0
                &kp Q         &hml LGUI S &hml LALT D &hms_l LSHIFT F &kp G         &kp H  &hms_r RSHIFT J &hmr RALT K &hmr RGUI L &kp P
                &hml LCTRL A  &kp X       &kp C       &kp V           &kp B         &kp N  &kp M           &kp COMMA   &kp PERIOD  &hmr RCTRL SEMICOLON
                &kp Z         &mkp MB4    &mkp MB1                                                         &kp DQT     &kp SQT     &kp FSLH
                &kp BACKSPACE &mo 3       &kp HOME    &tog 1          &mo 2         &mo 3  &kp DELETE      &kp END     &kp ENTER   &lt 2 SPACE 
            >;
        };

        // Gaming layer
        layer1 {
            //                                    | | 
            bindings = <
                       &trans    &trans &trans &kp ESC    &trans &trans &trans &trans
                &trans &trans    &trans &trans &trans     &trans &trans &trans &trans &trans
                &trans &kp S     &kp D  &kp F  &trans     &trans &trans &trans &trans &trans
                &kp A  &trans    &trans &trans &trans     &trans &trans &trans &trans &trans
                &trans &kp RCTRL &kp RALT                               &trans &trans &trans
                &trans &trans    &trans &trans &trans     &trans &trans &trans &trans &trans
            >;
        };

        // symbol layer
        layer2 {
            //                                                                         | |
            bindings = <
                                &kp F2         &kp F3         &kp F4           &kp F5      &kp F8    &kp F9         &kp F10      &kp F11
                &kp F1          &kp AT         &kp PIPE       &kp LBRC         &kp RBRC    &kp DQT   &kp N7         &kp N8       &kp N9       &kp F12
                &kp EXCL        &hml LGUI DLLR &hml LALT BSLH &hml LSHIFT LPAR &kp RPAR    &kp EQUAL &hmr RSHIFT N4 &hmr RALT N5 &hmr RGUI N6 &kp STAR
                &hml LCTRL HASH &kp CARET      &kp FSLH       &kp LBKT         &kp RBKT    &kp AMPS  &kp N1         &kp N2       &kp N3       &hmr RCTRL PLUS
                &kp PRCNT       &kp GRAVE      &kp TILDE                                                            &trans       &trans       &kp BSLH
                &trans          &trans         &trans         &trans           &trans      &trans    &trans         &trans       &trans       &trans
            >;
        };

        // movement and symbol layer
        layer3 {
            //                                                                       | | 
            bindings = <
                             &bt BT_SEL 1      &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &out OUT_BLE &out OUT_USB &trans      &trans
                &bt BT_SEL 0 &trans            &trans       &trans       &trans           &kp STAR     &kp ESC     &kp UP         &trans    &trans
                &bt BT_CLR   &trans            &trans       &trans       &trans           &kp MINUS    &kp LEFT    &kp DOWN       &kp RIGHT &trans
                &trans       &trans            &trans       &trans       &trans           &kp AMPS     &kp TAB      &kp DQT     &trans         &trans
                &trans       &ext_power EP_TOG &bootloader                                                          &bootloader &studio_unlock &trans
                &trans       &trans            &trans       &trans       &trans           &trans       &trans       &trans      &trans         &trans
            >;
        };

    };
};
